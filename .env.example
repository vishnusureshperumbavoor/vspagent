# ==============================================================================
# vspagent — Environment Configuration Template
# Copy this file to `.env` (or `~/.vspagent/.env`) and fill in your credentials.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. JarvisLabs Cloud GPU Configuration
# ------------------------------------------------------------------------------
# API token from https://jarvislabs.ai/ (Settings -> API Keys)
JARVIS_LABS_API_TOKEN=your_jarvislabs_api_token_here
# Optional alias recognized by official jarvislabs SDK:
# JL_API_KEY=your_jarvislabs_api_token_here

# ------------------------------------------------------------------------------
# 2. vspagent Background Daemon Configuration
# ------------------------------------------------------------------------------
# Local port for the persistent vspagent daemon (default: 4096)
VSPAGENT_PORT=4096

# ------------------------------------------------------------------------------
# 3. Google Colab MCP & Chrome Profile Discovery (Optional Overrides)
# ------------------------------------------------------------------------------
# Override Chrome User Data directory (auto-detected on Linux, macOS, Windows & WSL)
# CHROME_USER_DATA_DIR=/home/user/.config/google-chrome

# Override Chrome binary executable path
# CHROME_EXECUTABLE=/usr/bin/google-chrome

# Preferred Windows username when running inside WSL
# WINDOWS_USERNAME=your_windows_username

# Temporary state file for active Colab Chrome profile selection
# VSP_COLAB_PROFILE_STATE=/tmp/vspagent_colab_chrome_profile.json
