# vspagent — environment template
# Copy to .env or export these in your shell. Never commit real keys.

# Default provider: kimi, openai, deepseek, qwen, grok or gemini.
VSPAGENT_PROVIDER=kimi

# Kimi / Moonshot (OpenAI-compatible).
KIMI_API_KEY=

# Other OpenAI-compatible providers.
OPENAI_API_KEY=
DEEPSEEK_API_KEY=
DASHSCOPE_API_KEY=
XAI_API_KEY=
GEMINI_API_KEY=

# Optional overrides.
# VSPAGENT_MODEL=kimi-k2.7-code
# VSPAGENT_BASE_URL=https://api.moonshot.ai/v1
# VSPAGENT_PERMISSION_MODE=ask
# VSPAGENT_CONFIG_DIR=~/.config/vspagent
# VSPAGENT_DATA_DIR=~/.local/share/vspagent
